#version 460

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 256) in;

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
    uint baseMeshlet;
    uint meshletCount;
    uint alphaMode;
    uint materialId;
};

struct TaskWorkgroup {
    uint objectID;
    uint baseMeshletIndex;
};

struct TaskDispatchCommand {
    uint taskDispatchX;
    uint taskDispatchY;
    uint taskDispatchZ;
};

layout(std430, set = 0, binding = 5) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 1, binding = 0) buffer DispatchCommandBuffer {
    uint visibleObjectCount;
    uint dispatchY;
    uint dispatchZ;
};

layout(std430, set = 1, binding = 1) buffer VisibleObjectBuffer {
    uint visibleObjects[];
};

layout(std430, set = 1, binding = 6) writeonly buffer TaskWorkgroupBuffer {
    TaskWorkgroup taskWorkgroups[];
};

layout(std430, set = 1, binding = 7) buffer TaskDispatchCommandBuffer {
    TaskDispatchCommand taskDispatchCommands[3];
};

layout(std430, set = 1, binding = 8) readonly buffer CascadeDataBuffer {
    mat4 cascadeViewProj[3];
    vec4 cascadePlanes[18];
    vec4 cameraForward;
};

layout(std430, set = 1, binding = 9) writeonly buffer MaskedTaskWorkgroupBuffer {
    TaskWorkgroup maskedTaskWorkgroups[];
};

layout(std430, set = 1, binding = 10) buffer MaskedTaskDispatchCommandBuffer {
    TaskDispatchCommand maskedTaskDispatchCommands[3];
};

layout(push_constant) uniform PushConsts {
    uint objectCount;
    uint actualObjectCount;
    uint cullFlags;
    uint maxTaskWgsPerCascade;
} push;

shared vec4 s_cascadePlanes[18];

void main() {
    uint gID = gl_GlobalInvocationID.x;
    uint ti = gl_LocalInvocationID.x;

    if (ti < 18u) {
        s_cascadePlanes[ti] = cascadePlanes[ti];
    }
    barrier();

    if (gID >= push.actualObjectCount)
        return;

    ObjectData obj = objects[gID];
    
    bool isMasked = ((obj.alphaMode & 3u) == 2u);

    vec4 sphere = obj.boundingSphere;
    mat4 model  = obj.modelMatrix;

    vec3 worldCenter = (model * vec4(sphere.xyz, 1.0)).xyz;

    float sqX = dot(model[0].xyz, model[0].xyz);
    float sqY = dot(model[1].xyz, model[1].xyz);
    float sqZ = dot(model[2].xyz, model[2].xyz);
    float maxScale = sqrt(max(max(sqX, sqY), sqZ));
    float worldRadius = sphere.w * maxScale;

    bool visibleInCascade[3];
    bool visibleInAnyCascade = false;

    if (push.cullFlags == 0) {
        visibleInCascade[0] = true;
        visibleInCascade[1] = true;
        visibleInCascade[2] = true;
        visibleInAnyCascade = true;
    } else {
        for (uint c = 0u; c < 3u; c++) {
            bool visible = true;
            for (uint p = 0u; p < 6u; p++) {
                vec4 plane = s_cascadePlanes[c * 6u + p];
                if (dot(plane.xyz, worldCenter) + plane.w < -worldRadius) {
                    visible = false;
                    break;
                }
            }
            visibleInCascade[c] = visible;
            if (visible) {
                visibleInAnyCascade = true;
            }
        }
    }

    uint baseTaskWgCount = (obj.meshletCount + 31u) / 32u;

    #ifdef GL_KHR_shader_subgroup_arithmetic
    uint visibleFlag = visibleInAnyCascade ? 1u : 0u;
    uint waveObjCount = subgroupAdd(visibleFlag);
    uint waveObjOffset = subgroupExclusiveAdd(visibleFlag);
    uint waveObjBase = 0u;

    if (subgroupElect()) {
        if (waveObjCount > 0u) {
            waveObjBase = atomicAdd(visibleObjectCount, waveObjCount);
        }
    }
    waveObjBase = subgroupBroadcast(waveObjBase, subgroupBallotFindLSB(subgroupBallot(true)));

    if (visibleInAnyCascade) {
        visibleObjects[waveObjBase + waveObjOffset] = gID;
    }

    uint opaqueWgCount = (!isMasked) ? baseTaskWgCount : 0u;
    uint maskedWgCount = isMasked ? baseTaskWgCount : 0u;

    for (uint c = 0u; c < 3u; c++) {
        uint opaqueCount = visibleInCascade[c] ? opaqueWgCount : 0u;
        uint maskedCount = visibleInCascade[c] ? maskedWgCount : 0u;

        uint waveOpaqueCount = subgroupAdd(opaqueCount);
        uint waveOpaqueOffset = subgroupExclusiveAdd(opaqueCount);

        uint waveMaskedCount = subgroupAdd(maskedCount);
        uint waveMaskedOffset = subgroupExclusiveAdd(maskedCount);

        uint waveOpaqueBase = 0u;
        uint waveMaskedBase = 0u;

        if (subgroupElect()) {
            if (waveOpaqueCount > 0u) {
                waveOpaqueBase = atomicAdd(taskDispatchCommands[c].taskDispatchX, waveOpaqueCount);
            }
            if (waveMaskedCount > 0u) {
                waveMaskedBase = atomicAdd(maskedTaskDispatchCommands[c].taskDispatchX, waveMaskedCount);
            }
        }

        waveOpaqueBase = subgroupBroadcast(waveOpaqueBase, subgroupBallotFindLSB(subgroupBallot(true)));
        waveMaskedBase = subgroupBroadcast(waveMaskedBase, subgroupBallotFindLSB(subgroupBallot(true)));

        if (visibleInCascade[c]) {
            uint cascadeBase = c * push.maxTaskWgsPerCascade;
            if (isMasked) {
                uint startSlot = cascadeBase + waveMaskedBase + waveMaskedOffset;
                for (uint i = 0u; i < maskedWgCount; i++) {
                    maskedTaskWorkgroups[startSlot + i].objectID = gID;
                    maskedTaskWorkgroups[startSlot + i].baseMeshletIndex = i * 32u;
                }
            } else {
                uint startSlot = cascadeBase + waveOpaqueBase + waveOpaqueOffset;
                for (uint i = 0u; i < opaqueWgCount; i++) {
                    taskWorkgroups[startSlot + i].objectID = gID;
                    taskWorkgroups[startSlot + i].baseMeshletIndex = i * 32u;
                }
            }
        }
    }
    #else
    if (visibleInAnyCascade) {
        uint slot = atomicAdd(visibleObjectCount, 1u);
        visibleObjects[slot] = gID;
    }

    for (uint c = 0u; c < 3u; c++) {
        if (visibleInCascade[c]) {
            uint cascadeBase = c * push.maxTaskWgsPerCascade;
            if (isMasked) {
                uint startSlot = atomicAdd(maskedTaskDispatchCommands[c].taskDispatchX, baseTaskWgCount);
                uint dst = cascadeBase + startSlot;
                for (uint i = 0u; i < baseTaskWgCount; i++) {
                    maskedTaskWorkgroups[dst + i].objectID = gID;
                    maskedTaskWorkgroups[dst + i].baseMeshletIndex = i * 32u;
                }
            } else {
                uint startSlot = atomicAdd(taskDispatchCommands[c].taskDispatchX, baseTaskWgCount);
                uint dst = cascadeBase + startSlot;
                for (uint i = 0u; i < baseTaskWgCount; i++) {
                    taskWorkgroups[dst + i].objectID = gID;
                    taskWorkgroups[dst + i].baseMeshletIndex = i * 32u;
                }
            }
        }
    }
    #endif
}
