#version 460

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 256) in;

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
    uint baseMeshlet;
    uint meshletCount;
    uint alphaMode;
    uint padding1;
};

struct TaskWorkgroup {
    uint objectID;
    uint baseMeshletIndex;
};

layout(std430, set = 0, binding = 5) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 1, binding = 0) buffer DispatchCommandBuffer {
    uint visibleObjectCount;
    uint dispatchY;
    uint dispatchZ;
};

layout(std430, set = 1, binding = 1) buffer VisibleObjectBuffer {
    uint visibleObjects[];
};

layout(std430, set = 1, binding = 6) writeonly buffer TaskWorkgroupBuffer {
    TaskWorkgroup taskWorkgroups[];
};

layout(std430, set = 1, binding = 7) buffer TaskDispatchCommandBuffer {
    uint taskDispatchX;
    uint taskDispatchY;
    uint taskDispatchZ;
};

layout(std430, set = 1, binding = 8) readonly buffer CascadeDataBuffer {
    mat4 cascadeViewProj[3];
    vec4 cascadePlanes[18];
    vec4 cameraForward;
};

layout(std430, set = 1, binding = 9) writeonly buffer MaskedTaskWorkgroupBuffer {
    TaskWorkgroup maskedTaskWorkgroups[];
};

layout(std430, set = 1, binding = 10) buffer MaskedTaskDispatchCommandBuffer {
    uint maskedTaskDispatchX;
    uint maskedTaskDispatchY;
    uint maskedTaskDispatchZ;
};

layout(push_constant) uniform PushConsts {
    uint objectCount;
    uint actualObjectCount;
    uint cullFlags;
} push;

shared vec4 s_cascadePlanes[18];

void main() {
    uint gID = gl_GlobalInvocationID.x;
    uint ti = gl_LocalInvocationID.x;

    if (ti < 18u) {
        s_cascadePlanes[ti] = cascadePlanes[ti];
    }
    barrier();

    if (gID >= push.actualObjectCount)
        return;

    ObjectData obj = objects[gID];
    
    bool isMasked = ((obj.alphaMode & 3u) == 2u);

    vec4 sphere = obj.boundingSphere;
    mat4 model  = obj.modelMatrix;

    vec3 worldCenter = (model * vec4(sphere.xyz, 1.0)).xyz;

    float sqX = dot(model[0].xyz, model[0].xyz);
    float sqY = dot(model[1].xyz, model[1].xyz);
    float sqZ = dot(model[2].xyz, model[2].xyz);
    float maxScale = sqrt(max(max(sqX, sqY), sqZ));
    float worldRadius = sphere.w * maxScale;

    bool visibleInAnyCascade = false;

    if (push.cullFlags == 0) {
        visibleInAnyCascade = true;
    } else {
        for (uint c = 0u; c < 3u; c++) {
            bool visible = true;
            for (uint p = 0u; p < 6u; p++) {
                vec4 plane = s_cascadePlanes[c * 6u + p];
                if (dot(plane.xyz, worldCenter) + plane.w < -worldRadius) {
                    visible = false;
                    break;
                }
            }

            if (visible) {
                visibleInAnyCascade = true;
                break;
            }
        }
    }

    uint taskWgCount = visibleInAnyCascade ? ((obj.meshletCount + 31u) / 32u) : 0u;

    #ifdef GL_KHR_shader_subgroup_arithmetic
    uint visibleFlag = visibleInAnyCascade ? 1u : 0u;
    uint waveObjCount = subgroupAdd(visibleFlag);
    uint waveObjOffset = subgroupExclusiveAdd(visibleFlag);

    uint opaqueTaskWgCount = (!isMasked) ? taskWgCount : 0u;
    uint maskedTaskWgCount = isMasked ? taskWgCount : 0u;

    uint waveOpaqueTaskCount = subgroupAdd(opaqueTaskWgCount);
    uint waveOpaqueTaskOffset = subgroupExclusiveAdd(opaqueTaskWgCount);

    uint waveMaskedTaskCount = subgroupAdd(maskedTaskWgCount);
    uint waveMaskedTaskOffset = subgroupExclusiveAdd(maskedTaskWgCount);

    uint waveObjBase = 0u;
    uint waveTaskBase = 0u;
    uint waveMaskedTaskBase = 0u;

    if (subgroupElect()) {
        if (waveObjCount > 0u) {
            waveObjBase = atomicAdd(visibleObjectCount, waveObjCount);
        }
        if (waveOpaqueTaskCount > 0u) {
            waveTaskBase = atomicAdd(taskDispatchX, waveOpaqueTaskCount);
        }
        if (waveMaskedTaskCount > 0u) {
            waveMaskedTaskBase = atomicAdd(maskedTaskDispatchX, waveMaskedTaskCount);
        }
    }
    
    waveObjBase = subgroupBroadcast(waveObjBase, subgroupBallotFindLSB(subgroupBallot(true)));
    waveTaskBase = subgroupBroadcast(waveTaskBase, subgroupBallotFindLSB(subgroupBallot(true)));
    waveMaskedTaskBase = subgroupBroadcast(waveMaskedTaskBase, subgroupBallotFindLSB(subgroupBallot(true)));

    if (visibleInAnyCascade) {
        visibleObjects[waveObjBase + waveObjOffset] = gID;
        uint startSlot = isMasked ? (waveMaskedTaskBase + waveMaskedTaskOffset) : (waveTaskBase + waveOpaqueTaskOffset);
        for (uint i = 0u; i < taskWgCount; i++) {
            if (isMasked) {
                maskedTaskWorkgroups[startSlot + i].objectID = gID;
                maskedTaskWorkgroups[startSlot + i].baseMeshletIndex = i * 32u;
            } else {
                taskWorkgroups[startSlot + i].objectID = gID;
                taskWorkgroups[startSlot + i].baseMeshletIndex = i * 32u;
            }
        }
    }
    #else
    if (visibleInAnyCascade) {
        uint slot = atomicAdd(visibleObjectCount, 1u);
        visibleObjects[slot] = gID;
        
        uint startSlot;
        if (isMasked) {
            startSlot = atomicAdd(maskedTaskDispatchX, taskWgCount);
        } else {
            startSlot = atomicAdd(taskDispatchX, taskWgCount);
        }
        
        for (uint i = 0u; i < taskWgCount; i++) {
            if (isMasked) {
                maskedTaskWorkgroups[startSlot + i].objectID = gID;
                maskedTaskWorkgroups[startSlot + i].baseMeshletIndex = i * 32u;
            } else {
                taskWorkgroups[startSlot + i].objectID = gID;
                taskWorkgroups[startSlot + i].baseMeshletIndex = i * 32u;
            }
        }
    }
    #endif
}
