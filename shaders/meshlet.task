#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_GOOGLE_include_directive : enable
#include "hiz_cull.glsl"

layout(local_size_x = 32) in;

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
    uint baseMeshlet;
    uint meshletCount;
    uint alphaMode;
    uint materialId;
};

struct Meshlet {
    float center_x;
    float center_y;
    float center_z;
    float radius;
    uint cone_axis_cutoff;
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint triangleCount;
};

layout(set = 0, binding = 1) uniform SceneUbo {
    mat4 viewProj;
    mat4 prevViewProj;
    vec4 frustumPlanes[6];
    vec4 cameraPos;
    vec4 directionalLight;
    mat4 lightViewProj[3];
    vec4 cascadesSplits;
    float maxReflectionLod;
    uint blueNoiseTexIndex;
    vec2 _pad;
} sceneUbo;

layout(std430, set = 0, binding = 5) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 0, binding = 8) readonly buffer MeshletBuffer {
    Meshlet meshlets[];
};

struct TaskWorkgroup {
    uint objectID;
    uint baseMeshletIndex;
};

layout(std430, set = 1, binding = 6) readonly buffer TaskWorkgroupBuffer {
    TaskWorkgroup taskWorkgroups[];
};

layout(set = 1, binding = 8) uniform sampler2D hizPyramid;

layout(push_constant) uniform PushConsts {
    mat4 view;
    vec4 projParams;
    vec4 hizParams;
    vec2 screenParams;
    uint cullFlags;
    uint objectCount;
    uint actualObjectCount;
    uint objectCapacity;
    uint clipPlaneCount;
    uint isMeshShader;
    uint phase;
    uint pad;
} push;

const float SUBPIXEL_THRESHOLD = 0.0005;

struct Payload {
    uint objectID;
    uint meshletIndices[32];
};

taskPayloadSharedEXT Payload payload;

shared uint s_meshletCount[32];

void main() {
    uint ti = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.x;
    
    TaskWorkgroup twg = taskWorkgroups[wg];
    uint objectID = twg.objectID;
    uint localMeshletIdx = twg.baseMeshletIndex + ti;
    
    ObjectData obj = objects[objectID];
    
    float sqX = dot(obj.modelMatrix[0].xyz, obj.modelMatrix[0].xyz);
    float sqY = dot(obj.modelMatrix[1].xyz, obj.modelMatrix[1].xyz);
    float sqZ = dot(obj.modelMatrix[2].xyz, obj.modelMatrix[2].xyz);
    float maxScale = sqrt(max(max(sqX, sqY), sqZ));

    bool visible = false;
    
    if (localMeshletIdx < obj.meshletCount) {
        uint globalMeshletID = obj.baseMeshlet + localMeshletIdx;
        Meshlet m = meshlets[globalMeshletID];
        
        vec3 localCenter = vec3(m.center_x, m.center_y, m.center_z);
        vec3 worldCenter = (obj.modelMatrix * vec4(localCenter, 1.0)).xyz;
        float worldRadius = m.radius * maxScale;
        
        visible = true;
        if ((push.cullFlags & 1u) != 0u) {
            for (uint p = 0u; p < push.clipPlaneCount; p++) {
                if (dot(sceneUbo.frustumPlanes[p].xyz, worldCenter) + sceneUbo.frustumPlanes[p].w < -worldRadius) {
                    visible = false;
                    break;
                }
            }
        }
        
        if (visible && (push.cullFlags & 2u) != 0u) {
            vec3 camToCenter = worldCenter - sceneUbo.cameraPos.xyz;
            float dist = length(camToCenter);
            if (dist > worldRadius) {
                float projRadius = (worldRadius / dist) * abs(sceneUbo.cameraPos.w);
                if (projRadius < SUBPIXEL_THRESHOLD) {
                    visible = false;
                }
            }
        }

        if (visible) {
            vec4 cone = unpackSnorm4x8(m.cone_axis_cutoff);
            vec3 cone_axis_local = cone.xyz;
            float cone_cutoff = cone.w;
            
            bool doubleSided = (obj.alphaMode & 4u) != 0u;

            if (!doubleSided && cone_cutoff < 0.99) {
                vec3 cone_axis_world = normalize(mat3(obj.normalMatrix) * cone_axis_local);

                vec3 camToCenter = worldCenter - sceneUbo.cameraPos.xyz;
                float distSq = dot(camToCenter, camToCenter);
                if (distSq > worldRadius * worldRadius) {
                    float dist2 = sqrt(distSq);
                    vec3 dir_to_center = camToCenter / dist2;

                    float sin_subtended = clamp(worldRadius / dist2, 0.0, 1.0);
                    float cos_subtended = sqrt(1.0 - sin_subtended * sin_subtended);
                    float cone_sin = sqrt(max(0.0, 1.0 - cone_cutoff * cone_cutoff));
                    float max_dot = cone_cutoff * cos_subtended + cone_sin * sin_subtended;

                    if (dot(cone_axis_world, dir_to_center) >= max_dot) {
                        visible = false;
                    }
                }
            }
        }

        if (visible && (push.cullFlags & 4u) != 0u) {
            vec3 centerView = (push.view * vec4(worldCenter, 1.0)).xyz;
            if (isSphereOccludedHiZ(hizPyramid, centerView, worldRadius, push.projParams, push.hizParams, push.screenParams)) {
                visible = false;
            }
        }

        if (push.cullFlags == 0u) {
            visible = true;
        }
    }
    
    uvec4 ballot = subgroupBallot(visible);
    uint subgroupCount = subgroupBallotBitCount(ballot);
    uint subgroupOffset = subgroupBallotExclusiveBitCount(ballot);
    
    if (subgroupElect()) {
        s_meshletCount[gl_SubgroupID] = subgroupCount;
    }
    
    barrier();
    
    uint exclusiveOffset = subgroupOffset;
    for (uint i = 0; i < gl_SubgroupID; i++) {
        exclusiveOffset += s_meshletCount[i];
    }
    
    uint totalSurvivingCount = 0;
    for (uint i = 0; i < gl_NumSubgroups; i++) {
        totalSurvivingCount += s_meshletCount[i];
    }
    
    if (visible) {
        payload.meshletIndices[exclusiveOffset] = localMeshletIdx;
    }
    
    barrier();
    
    if (gl_LocalInvocationID.x == 0) {
        payload.objectID = objectID;
        EmitMeshTasksEXT(totalSurvivingCount, 1, 1);
    }
}
