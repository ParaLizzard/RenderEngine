#version 460

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0) uniform sampler2D samplerDepth;
layout (binding = 1) uniform sampler2D ssaoNoise;

layout (constant_id = 0) const int SSAO_KERNEL_SIZE = 32;
layout (constant_id = 1) const float SSAO_RADIUS = 0.5;

layout (binding = 2) uniform UBO
{
    mat4 projection;
    mat4 invProjection;
    mat4 view;
    vec4 samples[32];
    float nearPlane;
    float farPlane;
} ubo;

layout (binding = 3, r8) uniform writeonly image2D outSsao;

vec3 reconstructViewPos(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 view = ubo.invProjection * clip;
    return view.xyz / view.w;
}

float reconstructViewZ(float depth, vec4 zParams) {
    return (zParams.x * depth + zParams.y) / (zParams.z * depth + zParams.w);
}

vec3 getNormalFromDepth(vec2 uv, vec3 posCenter, vec2 ssaoDim) {
    vec2 step = 1.0 / ssaoDim;
    vec2 uvR = uv + vec2(step.x, 0.0);
    vec2 uvL = uv - vec2(step.x, 0.0);
    vec2 uvT = uv + vec2(0.0, step.y);
    vec2 uvB = uv - vec2(0.0, step.y);

    vec3 posR = reconstructViewPos(uvR, texture(samplerDepth, uvR).r);
    vec3 posL = reconstructViewPos(uvL, texture(samplerDepth, uvL).r);
    vec3 posT = reconstructViewPos(uvT, texture(samplerDepth, uvT).r);
    vec3 posB = reconstructViewPos(uvB, texture(samplerDepth, uvB).r);

    vec3 dx = (abs(posR.z - posCenter.z) < abs(posL.z - posCenter.z)) ? (posR - posCenter) : (posCenter - posL);
    vec3 dy = (abs(posT.z - posCenter.z) < abs(posB.z - posCenter.z)) ? (posT - posCenter) : (posCenter - posB);

    vec3 n = cross(dy, dx);
    if (length(n) < 1e-6) return vec3(0.0, 0.0, -1.0);
    n = normalize(n);
    if (dot(n, -posCenter) < 0.0) {
        n = -n;
    }
    return n;
}

void main()
{
    ivec2 ssaoDim = imageSize(outSsao);
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    
    if (pixelCoords.x >= ssaoDim.x || pixelCoords.y >= ssaoDim.y) return;

    vec2 inUV = (vec2(pixelCoords) + 0.5) / vec2(ssaoDim);

    float depth = texture(samplerDepth, inUV).r;
    
    if (depth >= 0.99999) {
        imageStore(outSsao, pixelCoords, vec4(1.0));
        return;
    }

    vec3 fragPos = reconstructViewPos(inUV, depth);
    vec3 normal = getNormalFromDepth(inUV, fragPos, vec2(ssaoDim));

    ivec2 noiseDim = textureSize(ssaoNoise, 0);
    vec2 targetDim = vec2(ssaoDim);
    vec2 noiseScale = targetDim / vec2(noiseDim);
    vec3 randomVec = vec3(texture(ssaoNoise, inUV * noiseScale).xy, 0.0);
    if (length(randomVec) < 1e-4) randomVec = vec3(1.0, 0.0, 0.0);
    else randomVec = normalize(randomVec);

    vec3 tangent = randomVec - normal * dot(randomVec, normal);
    if (length(tangent) < 1e-4) {
        tangent = cross(normal, vec3(0.0, 0.0, 1.0));
        if (length(tangent) < 1e-4) tangent = cross(normal, vec3(0.0, 1.0, 0.0));
    }
    tangent = normalize(tangent);
    vec3 bitangent = cross(normal, tangent);
    mat3 TBN = mat3(tangent, bitangent, normal);

    vec2 projScale = vec2(ubo.projection[0][0], ubo.projection[1][1]);
    vec4 invZParams = vec4(ubo.invProjection[2][2], ubo.invProjection[3][2], ubo.invProjection[2][3], ubo.invProjection[3][3]);

    float occlusion = 0.0f;
    float validSamples = 0.0f;
    const float bias = 0.025f;

    for(int i = 0; i < SSAO_KERNEL_SIZE; i++)
    {
        vec3 samplePos = TBN * ubo.samples[i].xyz;
        samplePos = fragPos + samplePos * SSAO_RADIUS;

        float invZ = 1.0 / samplePos.z;
        vec2 sampleNDC = vec2(projScale.x * samplePos.x * invZ, projScale.y * samplePos.y * invZ);
        vec2 sampleUV = sampleNDC * 0.5f + 0.5f;

        float rawSampleDepth = texture(samplerDepth, sampleUV).r;
        float sampleDepthZ = reconstructViewZ(rawSampleDepth, invZParams);

        float rangeCheck = smoothstep(0.0, 1.0, 1.0 - (abs(fragPos.z - sampleDepthZ) / SSAO_RADIUS));

        occlusion += (sampleDepthZ <= samplePos.z - bias ? 1.0f : 0.0f) * rangeCheck;
        validSamples += rangeCheck;
    }

    float occlusionRatio = validSamples > 0.1f ? (occlusion / validSamples) : 0.0f;
    imageStore(outSsao, pixelCoords, vec4(1.0f - occlusionRatio));
}