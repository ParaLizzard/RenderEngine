#version 460

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0) uniform sampler2D samplerDepth;

struct CompactMaterial {
    uint packedNormal;
    uint packedRadiance;
    uint packedAO;
    uint padding;
};

layout(std430, binding = 1) readonly buffer NormalBuffer {
    uint packedNormals[];
};

layout (binding = 2) uniform sampler2D ssaoNoise;

layout (constant_id = 0) const int SSAO_KERNEL_SIZE = 32;
layout (constant_id = 1) const float SSAO_RADIUS = 0.5;

layout (binding = 3) uniform UBO
{
    mat4 projection;
    mat4 invProjection;
    mat4 view;
    vec4 samples[32];
    float nearPlane;
    float farPlane;
} ubo;

layout (binding = 4, r8) uniform writeonly image2D outSsao;

vec3 reconstructViewPos(vec2 uv, float depth) {
    vec2 ndc = uv * 2.0 - 1.0;
    float w = ubo.invProjection[2][3] * depth + ubo.invProjection[3][3];
    vec3 viewPos;
    viewPos.x = ubo.invProjection[0][0] * ndc.x + ubo.invProjection[2][0] * depth + ubo.invProjection[3][0];
    viewPos.y = ubo.invProjection[1][1] * ndc.y + ubo.invProjection[2][1] * depth + ubo.invProjection[3][1];
    viewPos.z = ubo.invProjection[2][2] * depth + ubo.invProjection[3][2];
    return viewPos / w;
}

vec3 decodeOctNormal(uint packedNormal) {
    vec2 f = vec2(packedNormal & 0xFFu, (packedNormal >> 8u) & 0xFFu) / 255.0 * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return normalize(n);
}

void main()
{
    ivec2 ssaoDim = imageSize(outSsao);
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    
    if (pixelCoords.x >= ssaoDim.x || pixelCoords.y >= ssaoDim.y) return;

    vec2 inUV = (vec2(pixelCoords) + 0.5) / vec2(ssaoDim);

    float depth = texture(samplerDepth, inUV).r;
    
    if (depth == 1.0) {
        imageStore(outSsao, pixelCoords, vec4(1.0));
        return;
    }

    vec3 fragPos = reconstructViewPos(inUV, depth);

    ivec2 depthDim = textureSize(samplerDepth, 0);
    ivec2 fullResCoords = ivec2(inUV * vec2(depthDim));
    uint pixelIndex = fullResCoords.y * depthDim.x + fullResCoords.x;

    uint packedNormal = packedNormals[pixelIndex];
    vec3 worldNormal = decodeOctNormal(packedNormal);

    vec3 normal = mat3(ubo.view) * worldNormal;
    normal = normalize(normal);

    ivec2 noiseDim = textureSize(ssaoNoise, 0);
    vec2 targetDim = vec2(ssaoDim);
    vec2 noiseScale = targetDim / vec2(noiseDim);
    vec3 randomVec = texture(ssaoNoise, inUV * noiseScale).xyz;

    vec3 tangent = normalize(randomVec - normal * dot(randomVec, normal));
    vec3 bitangent = cross(normal, tangent);
    mat3 TBN = mat3(tangent, bitangent, normal);

    float occlusion = 0.0f;
    float validSamples = 0.0f;
    const float bias = 0.025f;

    for(int i = 0; i < SSAO_KERNEL_SIZE; i++)
    {
        vec3 samplePos = TBN * ubo.samples[i].xyz;
        samplePos = fragPos + samplePos * SSAO_RADIUS;

        vec4 offset;
        offset.x = samplePos.x * ubo.projection[0][0] + samplePos.z * ubo.projection[2][0] + ubo.projection[3][0];
        offset.y = samplePos.y * ubo.projection[1][1] + samplePos.z * ubo.projection[2][1] + ubo.projection[3][1];
        offset.z = samplePos.z * ubo.projection[2][2] + ubo.projection[3][2];
        offset.w = samplePos.z * ubo.projection[2][3] + ubo.projection[3][3];
        offset.xyz /= offset.w;
        offset.xy = offset.xy * 0.5f + 0.5f;

        float rawSampleDepth = texture(samplerDepth, offset.xy).r;
        vec3 sampledViewPos = reconstructViewPos(offset.xy, rawSampleDepth);
        float sampleDepthZ = sampledViewPos.z;

        float rangeCheck = smoothstep(0.0, 1.0, 1.0 - (abs(fragPos.z - sampleDepthZ) / SSAO_RADIUS));

        occlusion += (sampleDepthZ <= samplePos.z - bias ? 1.0f : 0.0f) * rangeCheck;
        validSamples += rangeCheck;
    }

    float occlusionRatio = validSamples > 0.1f ? (occlusion / validSamples) : 0.0f;
    imageStore(outSsao, pixelCoords, vec4(1.0f - occlusionRatio));
}