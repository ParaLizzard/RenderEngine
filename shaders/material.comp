#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_quad : enable
#extension GL_EXT_shader_8bit_storage : require

#include "common/oct_encoding.glsl"
#include "common/brdf_pbr.glsl"
#include "common/shadow_csm.glsl"
#include "common/visbuffer_barycentrics.glsl"

struct MaterialData {
    vec4 albedoFactor;
    vec4 emissiveFactor;
    uint albedoIndex;
    uint normalIndex;
    uint roughnessMetallicIndex;
    uint emissiveIndex;
    uint occlusionIndex;
    uint flags;
    float alphaCutoff;
    float normalScale;
    float roughnessFactor;
    float metallicFactor;
    uint padding0;
    uint padding1;
};

layout(set = 0, binding = 0) readonly buffer MaterialHeapBuffer {
    MaterialData materials[];
} materialHeap;

layout(set = 0, binding = 1) uniform SceneUbo {
    mat4 viewProj;
    mat4 prevViewProj;
    vec4 frustumPlanes[6];
    vec4 cameraPos;
    vec4 directionalLight;
    mat4 lightViewProj[3];
    vec4 cascadesSplits;
    float maxReflectionLod;
    uint blueNoiseTexIndex;
    vec2 _pad;
} sceneUbo;

layout(set = 0, binding = 2) uniform samplerCube irradianceMap;
layout(set = 0, binding = 3) uniform samplerCube prefilterMap;
layout(set = 0, binding = 12) uniform sampler2D bindlessTextures[];

struct PositionData {
    float x, y, z;
};

layout(set = 0, binding = 6) readonly buffer VertexBuffer {
    PositionData positions[];
} vertexBuffer;

struct Meshlet {
    float center_x;
    float center_y;
    float center_z;
    float radius;
    uint cone_axis_cutoff;
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint triangleCount;
};

layout(std430, set = 0, binding = 8) readonly buffer MeshletBuffer { Meshlet meshlets[]; };
layout(std430, set = 0, binding = 9) readonly buffer MeshletVertexMap { uint meshletVertices[]; };
layout(std430, set = 0, binding = 10) readonly buffer MeshletTriangleMap { uint8_t meshletTriangles[]; };

layout(set = 1, binding = 3) uniform usampler2D visBufferTexture;

struct VertexAttribute {
    uint tangent_lo;
    uint tangent_hi;
    uint uv_packed;
    uint normal_oct;
};

layout(set = 0, binding = 7) readonly buffer AttributeBuffer {
    VertexAttribute attributes[];
} attributeBuffer;

layout(set = 1, binding = 9) uniform writeonly image2D finalRenderOut;
layout(set = 1, binding = 10) uniform sampler2D ssaoBlurTex;
layout(set = 1, binding = 12) uniform sampler2D csmDepthMap;
layout(set = 1, binding = 13) uniform sampler2DShadow csmShadowMap;

layout(constant_id = 0) const uint ENABLE_PCSS = 0;
layout(constant_id = 1) const uint PCF_SAMPLES_C0 = 8;
layout(constant_id = 2) const uint PCF_SAMPLES_C1 = 4;
layout(constant_id = 3) const uint PCF_SAMPLES_C2 = 4;

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
    uint baseMeshlet;
    uint meshletCount;
    uint alphaMode;
    uint materialId;
};

layout(set = 0, binding = 5) readonly buffer ObjectBuffer {
    ObjectData objects[];
} objectBuffer;

layout(push_constant) uniform PushConstants {
    mat4 viewProj;
    mat4 view;
    vec3 cameraPos;
    uint enableSSAO;
    uint debugMode;
    float ssaoStrength;
    vec2 jitterOffset;
    vec2 resolution;
    vec2 rcpResolution;
} pc;

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    uint linearIdx = gl_LocalInvocationIndex;
    uint quadIdx = linearIdx / 4u;
    uint laneInQuad = linearIdx % 4u;
    uvec2 quadPosInTile = uvec2(quadIdx % 8u, quadIdx / 8u) * 2u;
    uvec2 pixelInQuad = uvec2(laneInQuad & 1u, laneInQuad >> 1u);
    ivec2 pixel = ivec2(gl_WorkGroupID.xy * uvec2(16u, 16u) + quadPosInTile + pixelInQuad);

    bool isOutOfBounds = (pixel.x >= int(pc.resolution.x) || pixel.y >= int(pc.resolution.y));

    uvec4 visPacked = uvec4(0u);
    if (!isOutOfBounds) {
        visPacked = texelFetch(visBufferTexture, pixel, 0);
    }

    uint rawInstanceID = visPacked.x;
    uint primitiveID = visPacked.y;
    bool isBackground = (rawInstanceID == 0u);
    bool isActivePixel = !isOutOfBounds && !isBackground;

    if (!isOutOfBounds && isBackground) {
        imageStore(finalRenderOut, pixel, vec4(0.1, 0.1, 0.12, 1.0));
    }
    if (!isActivePixel) return;

    uint instanceID = rawInstanceID - 1u;

    mat4 modelMatrix;
    mat3 normalMatrix;
    uint baseMeshlet;
    uint materialId;

    if (subgroupAllEqual(instanceID)) {
        if (subgroupElect()) {
            ObjectData obj = objectBuffer.objects[instanceID];
            modelMatrix = obj.modelMatrix;
            normalMatrix = mat3(obj.normalMatrix);
            baseMeshlet = obj.baseMeshlet;
            materialId = obj.materialId;
        }
        modelMatrix[0] = subgroupBroadcastFirst(modelMatrix[0]);
        modelMatrix[1] = subgroupBroadcastFirst(modelMatrix[1]);
        modelMatrix[2] = subgroupBroadcastFirst(modelMatrix[2]);
        modelMatrix[3] = subgroupBroadcastFirst(modelMatrix[3]);

        normalMatrix[0] = subgroupBroadcastFirst(normalMatrix[0]);
        normalMatrix[1] = subgroupBroadcastFirst(normalMatrix[1]);
        normalMatrix[2] = subgroupBroadcastFirst(normalMatrix[2]);

        baseMeshlet = subgroupBroadcastFirst(baseMeshlet);
        materialId = subgroupBroadcastFirst(materialId);
    } else {
        ObjectData obj = objectBuffer.objects[instanceID];
        modelMatrix = obj.modelMatrix;
        normalMatrix = mat3(obj.normalMatrix);
        baseMeshlet = obj.baseMeshlet;
        materialId = obj.materialId;
    }

    vec3 worldPos;
    vec3 normal;
    vec4 tangent;
    vec2 texCoord;
    uint meshletID;

    {
        uint localMeshletID;
        uint triangleIndexOffset;
        decodeSyntheticIndex(primitiveID, localMeshletID, triangleIndexOffset);
        meshletID = baseMeshlet + localMeshletID;

        uvec2 primKey = uvec2(instanceID, primitiveID);
        uvec2 quadPrim0 = subgroupQuadBroadcast(primKey, 0u);
        bool quadUniform = (primKey == quadPrim0) &&
                           (subgroupQuadBroadcast(primKey, 1u) == quadPrim0) &&
                           (subgroupQuadBroadcast(primKey, 2u) == quadPrim0) &&
                           (subgroupQuadBroadcast(primKey, 3u) == quadPrim0);

        mat4 mvp = pc.viewProj * modelMatrix;
        vec2 pixelNDC = (vec2(pixel) + 0.5) * pc.rcpResolution * 2.0 - 1.0;

        uint idx0, idx1, idx2;

        {
            Meshlet m = meshlets[meshletID];
            if (quadUniform) {
                if (laneInQuad == 0u) {
                    uint b0 = uint(meshletTriangles[m.indexOffset + triangleIndexOffset + 0u]);
                    uint b1 = uint(meshletTriangles[m.indexOffset + triangleIndexOffset + 1u]);
                    uint b2 = uint(meshletTriangles[m.indexOffset + triangleIndexOffset + 2u]);
                    idx0 = meshletVertices[m.vertexOffset + b0];
                    idx1 = meshletVertices[m.vertexOffset + b1];
                    idx2 = meshletVertices[m.vertexOffset + b2];
                }
                idx0 = subgroupQuadBroadcast(idx0, 0u);
                idx1 = subgroupQuadBroadcast(idx1, 0u);
                idx2 = subgroupQuadBroadcast(idx2, 0u);
            } else {
                uint b0 = uint(meshletTriangles[m.indexOffset + triangleIndexOffset + 0u]);
                uint b1 = uint(meshletTriangles[m.indexOffset + triangleIndexOffset + 1u]);
                uint b2 = uint(meshletTriangles[m.indexOffset + triangleIndexOffset + 2u]);
                idx0 = meshletVertices[m.vertexOffset + b0];
                idx1 = meshletVertices[m.vertexOffset + b1];
                idx2 = meshletVertices[m.vertexOffset + b2];
            }
        }

        vec3 bary;
        {
            vec3 p0_loc, p1_loc, p2_loc;

            if (quadUniform) {
                if (laneInQuad == 0u) {
                    PositionData pd0 = vertexBuffer.positions[idx0];
                    PositionData pd1 = vertexBuffer.positions[idx1];
                    PositionData pd2 = vertexBuffer.positions[idx2];
                    p0_loc = vec3(pd0.x, pd0.y, pd0.z);
                    p1_loc = vec3(pd1.x, pd1.y, pd1.z);
                    p2_loc = vec3(pd2.x, pd2.y, pd2.z);
                }
                p0_loc = subgroupQuadBroadcast(p0_loc, 0u);
                p1_loc = subgroupQuadBroadcast(p1_loc, 0u);
                p2_loc = subgroupQuadBroadcast(p2_loc, 0u);
            } else {
                PositionData pd0 = vertexBuffer.positions[idx0];
                PositionData pd1 = vertexBuffer.positions[idx1];
                PositionData pd2 = vertexBuffer.positions[idx2];
                p0_loc = vec3(pd0.x, pd0.y, pd0.z);
                p1_loc = vec3(pd1.x, pd1.y, pd1.z);
                p2_loc = vec3(pd2.x, pd2.y, pd2.z);
            }

            vec4 clip0 = mvp * vec4(p0_loc, 1.0);
            vec4 clip1 = mvp * vec4(p1_loc, 1.0);
            vec4 clip2 = mvp * vec4(p2_loc, 1.0);
            bary = solveBarycentrics(clip0, clip1, clip2, pixelNDC);
            vec3 p_local = bary.x * p0_loc + bary.y * p1_loc + bary.z * p2_loc;
            worldPos = (modelMatrix * vec4(p_local, 1.0)).xyz;
        }

        {
            vec4 t0_loc, t1_loc, t2_loc;
            vec4 uv_norm0, uv_norm1, uv_norm2;

            if (quadUniform) {
                if (laneInQuad == 0u) {
                    VertexAttribute va0 = attributeBuffer.attributes[idx0];
                    VertexAttribute va1 = attributeBuffer.attributes[idx1];
                    VertexAttribute va2 = attributeBuffer.attributes[idx2];
                    t0_loc = vec4(unpackHalf2x16(va0.tangent_lo), unpackHalf2x16(va0.tangent_hi));
                    t1_loc = vec4(unpackHalf2x16(va1.tangent_lo), unpackHalf2x16(va1.tangent_hi));
                    t2_loc = vec4(unpackHalf2x16(va2.tangent_lo), unpackHalf2x16(va2.tangent_hi));
                    uv_norm0 = vec4(unpackHalf2x16(va0.uv_packed), unpackHalf2x16(va0.normal_oct));
                    uv_norm1 = vec4(unpackHalf2x16(va1.uv_packed), unpackHalf2x16(va1.normal_oct));
                    uv_norm2 = vec4(unpackHalf2x16(va2.uv_packed), unpackHalf2x16(va2.normal_oct));
                }
                t0_loc = subgroupQuadBroadcast(t0_loc, 0u);
                t1_loc = subgroupQuadBroadcast(t1_loc, 0u);
                t2_loc = subgroupQuadBroadcast(t2_loc, 0u);
                uv_norm0 = subgroupQuadBroadcast(uv_norm0, 0u);
                uv_norm1 = subgroupQuadBroadcast(uv_norm1, 0u);
                uv_norm2 = subgroupQuadBroadcast(uv_norm2, 0u);
            } else {
                VertexAttribute va0 = attributeBuffer.attributes[idx0];
                VertexAttribute va1 = attributeBuffer.attributes[idx1];
                VertexAttribute va2 = attributeBuffer.attributes[idx2];
                t0_loc = vec4(unpackHalf2x16(va0.tangent_lo), unpackHalf2x16(va0.tangent_hi));
                t1_loc = vec4(unpackHalf2x16(va1.tangent_lo), unpackHalf2x16(va1.tangent_hi));
                t2_loc = vec4(unpackHalf2x16(va2.tangent_lo), unpackHalf2x16(va2.tangent_hi));
                uv_norm0 = vec4(unpackHalf2x16(va0.uv_packed), unpackHalf2x16(va0.normal_oct));
                uv_norm1 = vec4(unpackHalf2x16(va1.uv_packed), unpackHalf2x16(va1.normal_oct));
                uv_norm2 = vec4(unpackHalf2x16(va2.uv_packed), unpackHalf2x16(va2.normal_oct));
            }

            vec2 local_norm_oct = bary.x * uv_norm0.zw + bary.y * uv_norm1.zw + bary.z * uv_norm2.zw;
            vec3 localNormal = decodeOctNormalVec2(local_norm_oct);
            vec4 localTangent = bary.x * t0_loc + bary.y * t1_loc + bary.z * t2_loc;
            texCoord = bary.x * uv_norm0.xy + bary.y * uv_norm1.xy + bary.z * uv_norm2.xy;

            normal = normalize(normalMatrix * localNormal);
            tangent = vec4(normalMatrix * localTangent.xyz, localTangent.w);
        }
    }

    vec2 ddx_uv, ddy_uv;
    computeQuadUvDerivatives(texCoord, rawInstanceID, pixelInQuad, ddx_uv, ddy_uv);

    vec2 unjitteredTexCoord = texCoord - ddx_uv * pc.jitterOffset.x - ddy_uv * pc.jitterOffset.y;

    MaterialData mat;
    if (subgroupAllEqual(materialId)) {
        if (subgroupElect()) {
            mat = materialHeap.materials[materialId];
        }
        mat.albedoFactor = subgroupBroadcastFirst(mat.albedoFactor);
        mat.emissiveFactor = subgroupBroadcastFirst(mat.emissiveFactor);
        mat.albedoIndex = subgroupBroadcastFirst(mat.albedoIndex);
        mat.normalIndex = subgroupBroadcastFirst(mat.normalIndex);
        mat.roughnessMetallicIndex = subgroupBroadcastFirst(mat.roughnessMetallicIndex);
        mat.emissiveIndex = subgroupBroadcastFirst(mat.emissiveIndex);
        mat.occlusionIndex = subgroupBroadcastFirst(mat.occlusionIndex);
        mat.flags = subgroupBroadcastFirst(mat.flags);
        mat.alphaCutoff = subgroupBroadcastFirst(mat.alphaCutoff);
        mat.normalScale = subgroupBroadcastFirst(mat.normalScale);
        mat.roughnessFactor = subgroupBroadcastFirst(mat.roughnessFactor);
        mat.metallicFactor = subgroupBroadcastFirst(mat.metallicFactor);
    } else {
        mat = materialHeap.materials[materialId];
    }

    vec2 screenUV = (vec2(pixel) + 0.5) * pc.rcpResolution;
    float ssao = 1.0;
    if (pc.enableSSAO == 1u) {
        ssao = texture(ssaoBlurTex, screenUV).r;
    }

    vec3 albedo = textureGrad(bindlessTextures[nonuniformEXT(mat.albedoIndex)], unjitteredTexCoord, ddx_uv, ddy_uv).rgb * mat.albedoFactor.rgb;
    vec4 mrSample = textureGrad(bindlessTextures[nonuniformEXT(mat.roughnessMetallicIndex)], unjitteredTexCoord, ddx_uv, ddy_uv);

    float materialAO = 1.0;
    if (mat.occlusionIndex == mat.roughnessMetallicIndex) {
        materialAO = mrSample.r;
    } else if (mat.occlusionIndex != mat.albedoIndex && mat.occlusionIndex != 0u && mat.occlusionIndex != 0xFFFFFFFFu) {
        materialAO = textureGrad(bindlessTextures[nonuniformEXT(mat.occlusionIndex)], unjitteredTexCoord, ddx_uv, ddy_uv).r;
    }

    float roughness = mrSample.g * mat.roughnessFactor;
    float metalness = mrSample.b * mat.metallicFactor;

    vec3 worldNormal = normal;
    if (length(tangent.xyz) > 0.001 && abs(mat.normalScale) > 0.001) {
        vec3 normalMapSample = textureGrad(bindlessTextures[nonuniformEXT(mat.normalIndex)], unjitteredTexCoord, ddx_uv, ddy_uv).rgb;
        vec3 mappedNormal = normalize(vec3((normalMapSample.xy * 2.0 - 1.0) * mat.normalScale, normalMapSample.z * 2.0 - 1.0));
        vec3 bitangent = cross(normal, tangent.xyz) * tangent.w;
        mat3 tbn = mat3(normalize(tangent.xyz), normalize(bitangent), normal);
        worldNormal = normalize(tbn * mappedNormal);
    }

    vec3 lightDir = normalize(sceneUbo.directionalLight.xyz);
    vec3 viewDir  = normalize(pc.cameraPos - worldPos);

    const float MAX_REFLECTION_LOD = 4.0;
    vec3 R = reflect(-viewDir, worldNormal);
    vec3 irradiance = texture(irradianceMap, worldNormal).rgb;
    vec3 prefilteredColor = textureLod(prefilterMap, R, roughness * MAX_REFLECTION_LOD).rgb;

    float rawNdotL = dot(worldNormal, lightDir);
    float rawNdotV = dot(worldNormal, viewDir);
    float NdotL    = max(rawNdotL, 0.0);
    float NdotV    = max(rawNdotV, 0.001);

    vec3 F0 = mix(Fdielectric, albedo, metalness);

    vec3 directLight = vec3(0.0);
    uint cascadeIndex = 0u;

    if (rawNdotL > 0.0) {
        vec3 H = normalize(viewDir + lightDir);
        float lightRoughness = max(roughness, 0.05);

        vec3 F = fresnelSchlick(F0, max(dot(H, viewDir), 0.0));
        vec3 specular = vec3(0.0);
        if (rawNdotV > 0.0) {
            float NDF = ndfGGX(max(dot(worldNormal, H), 0.0), lightRoughness);
            float G   = gaSchlickGGX(NdotL, NdotV, lightRoughness);
            specular  = (NDF * G * F) / (4.0 * NdotV + Epsilon);
        }
        vec3 kD = (vec3(1.0) - F) * (1.0 - metalness);

        float depth = abs((pc.view * vec4(worldPos, 1.0)).z);
        float dither = 0.5;
        if (sceneUbo.blueNoiseTexIndex != 0u) {
            dither = texelFetch(bindlessTextures[nonuniformEXT(sceneUbo.blueNoiseTexIndex)], ivec2(pixel) & 127, 0).r;
        }

        cascadeIndex = selectCascadeDithered(depth, dither, sceneUbo.cascadesSplits);

        float slopeScale = 1.0 - rawNdotL;
        float normalBiasAmt = 0.005 + 0.01 * slopeScale;
        vec3 shadowWorldPos = worldPos + worldNormal * normalBiasAmt;

        vec4 shadowCoord = sceneUbo.lightViewProj[cascadeIndex] * vec4(shadowWorldPos, 1.0);
        shadowCoord.xy = shadowCoord.xy * 0.5 + 0.5;

        float shadowFactor = 1.0;
        if (shadowCoord.x > 0.0 && shadowCoord.x < 1.0 &&
            shadowCoord.y > 0.0 && shadowCoord.y < 1.0 &&
            shadowCoord.z > 0.0 && shadowCoord.z < 1.0) {

            const vec2 csmTexelSize = vec2(1.0 / 2048.0, 1.0 / 3072.0);
            float bias = 0.0002;

            if (ENABLE_PCSS == 1) {
                shadowFactor = evaluatePCSS(csmDepthMap, csmShadowMap, shadowCoord, cascadeIndex, bias, csmTexelSize, PCF_SAMPLES_C0, PCF_SAMPLES_C1, PCF_SAMPLES_C2);
            } else {
                shadowFactor = evaluatePCF(csmShadowMap, shadowCoord, cascadeIndex, bias, csmTexelSize, PCF_SAMPLES_C0, PCF_SAMPLES_C1, PCF_SAMPLES_C2);
            }
        }

        directLight = (kD * albedo / PI * NdotL + specular) * (sceneUbo.directionalLight.w * shadowFactor);
    }

    vec3 F_ambient  = fresnelSchlickRoughness(NdotV, F0, roughness);
    vec3 kD_ambient = (vec3(1.0) - F_ambient) * (1.0 - metalness);

    vec2 envBRDF = envBRDFApprox(NdotV, roughness);
    vec3 specular_ambient = prefilteredColor * (F_ambient * envBRDF.x + envBRDF.y);

    float combinedAO = ssao * materialAO;
    vec3 ambientLight = (kD_ambient * irradiance * albedo + specular_ambient) * combinedAO;

    vec3 finalRadiance = directLight + ambientLight;

    if (pc.debugMode == 1u) {
        finalRadiance = hashColor(primitiveID);
    } else if (pc.debugMode == 2u) {
        finalRadiance = hashColor(meshletID);
    } else if (pc.debugMode == 3u) {
        uint objID = primitiveID >> 22u;
        finalRadiance = hashColor(objID);
    } else if (pc.debugMode == 4u) {
        finalRadiance = vec3(combinedAO);
    } else if (pc.debugMode == 5u) {
        if (cascadeIndex == 0u) finalRadiance = vec3(1.0, 0.0, 0.0);
        else if (cascadeIndex == 1u) finalRadiance = vec3(0.0, 1.0, 0.0);
        else if (cascadeIndex == 2u) finalRadiance = vec3(0.0, 0.0, 1.0);
        else finalRadiance = vec3(1.0, 1.0, 0.0);
    } else if (pc.debugMode == 6u) {
        float depth = abs((pc.view * vec4(worldPos, 1.0)).z);
        float normalizedDepth = clamp(depth / 90.0, 0.0, 1.0);
        finalRadiance = vec3(normalizedDepth);
    } else if (pc.debugMode >= 7u && pc.debugMode <= 9u) {
        uint cIndex = pc.debugMode - 7u;
        vec4 sc = sceneUbo.lightViewProj[cIndex] * vec4(worldPos, 1.0);
        sc.xy = sc.xy * 0.5 + 0.5;
        if (sc.x >= 0.0 && sc.x <= 1.0 && sc.y >= 0.0 && sc.y <= 1.0) {
            vec2 atlasUV = sc.xy * cascadeAtlas[cIndex].xy + cascadeAtlas[cIndex].zw;
            float sDepth = texture(csmDepthMap, atlasUV).r;
            finalRadiance = vec3(sDepth);
        } else {
            finalRadiance = vec3(fract(sc.x), fract(sc.y), 0.0);
        }
    }

    imageStore(finalRenderOut, pixel, vec4(finalRadiance, 1.0));
}