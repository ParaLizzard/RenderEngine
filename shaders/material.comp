#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_ballot : enable

const float PI = 3.141592;
const vec3 Fdielectric = vec3(0.04);
const float Epsilon = 0.00001;

float ndfGGX(float cosLh, float roughness) {
    float alpha   = roughness * roughness;
    float alphaSq = alpha * alpha;
    float denom   = (cosLh * cosLh) * (alphaSq - 1.0) + 1.0;
    return alphaSq / (PI * denom * denom);
}

float gaSchlickG1(float cosTheta, float k) {
    return cosTheta / (cosTheta * (1.0 - k) + k);
}

float gaSchlickGGX(float cosLi, float cosLo, float roughness) {
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return gaSchlickG1(cosLi, k) * gaSchlickG1(cosLo, k);
}

vec3 fresnelSchlick(vec3 F0, float cosTheta) {
    return F0 + (vec3(1.0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

struct MaterialData {
    vec4 albedoFactor;
    vec4 emissiveFactor;
    uint albedoIndex;
    uint normalIndex;
    uint roughnessMetallicIndex;
    uint emissiveIndex;
    uint occlusionIndex;
    uint flags;
    float alphaCutoff;
    float normalScale;
    float roughnessFactor;
    float metallicFactor;
    uint padding0;
    uint padding1;
};

layout(set = 0, binding = 0) readonly buffer MaterialHeapBuffer {
    MaterialData materials[];
} materialHeap;

layout(set = 0, binding = 1) uniform SceneUbo {
    vec4 cameraPos;
    vec4 directionalLight; // xyz = dir, w = intensity
    mat4 lightViewProj[3];
    vec4 cascadesSplits;
    float maxReflectionLod;
    uint blueNoiseTexIndex;
    vec2 _pad;
} sceneUbo;

layout(set = 0, binding = 2) uniform samplerCube irradianceMap;
layout(set = 0, binding = 3) uniform samplerCube prefilterMap;
layout(set = 0, binding = 4) uniform sampler2D brdfLUT;

layout(set = 0, binding = 12) uniform sampler2D bindlessTextures[];

struct PositionData {
    float x, y, z;
};
layout(set = 0, binding = 6) readonly buffer VertexBuffer {
    PositionData positions[];
} vertexBuffer;

layout(set = 0, binding = 11) readonly buffer IndexBuffer {
    uint indices[];
} indexBuffer;

struct Mesh {
    uint firstIndex;
    int vertexOffset;
};
layout(set = 1, binding = 2) readonly buffer MeshBuffer {
    Mesh meshes[];
} meshBuffer;

layout(set = 1, binding = 3) uniform usampler2D visBufferTexture;
layout(set = 1, binding = 4) uniform sampler2D depthTexture;

struct CompactMaterial {
    uint packedNormal;
    uint packedRadiance;
    uint packedAO;
    uint padding;
};

layout(set = 1, binding = 5) writeonly buffer NormalBuffer {
    uint packedNormals[];
} normalOut;

layout(set = 1, binding = 6) writeonly buffer WorldBuffer {
    vec4 worldPositions[];
} worldOut;

struct VertexAttribute {
    float colorR, colorG, colorB;
    float normalX, normalY, normalZ;
    float uvX, uvY;
    float tangentX, tangentY, tangentZ, tangentW;
    uint texId;
};

layout(set = 0, binding = 7) readonly buffer AttributeBuffer {
    VertexAttribute attributes[];
} attributeBuffer;

layout(set = 1, binding = 9) uniform writeonly image2D finalRenderOut;
layout(set = 1, binding = 10) uniform sampler2D ssaoBlurTex;

layout(set = 1, binding = 11) writeonly buffer RadianceBuffer {
    uint packedRadiances[];
} radianceOut;
layout(set = 1, binding = 12) uniform sampler2DArray csmDepthMap;
layout(set = 1, binding = 13) uniform sampler2DArrayShadow csmShadowMap;
layout(constant_id = 0) const uint ENABLE_PCSS = 1;

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
};

layout(set = 0, binding = 5) readonly buffer ObjectBuffer {
    ObjectData objects[];
} objectBuffer;

layout(push_constant) uniform PushConstants {
    mat4 viewProj;
    mat4 view;
    vec3 cameraPos;
    uint enableSSAO;
} pc;

uint encodeOctNormal(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    vec2 res = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * sign(n.xy);
    uvec2 packedInput = uvec2(round(clamp(res * 0.5 + 0.5, 0.0, 1.0) * 255.0));
    return packedInput.x | (packedInput.y << 8u);
}

uint encodeRadiance(vec3 color) {
    uvec3 quantized = uvec3(clamp(color, 0.0, 1.0) * 1023.0);
    return quantized.x | (quantized.y << 10u) | (quantized.z << 20u);
}

vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness) {
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

const vec2 poissonDisk[16] = vec2[]( 
    vec2(-0.94201624, -0.39906216), vec2( 0.94558609, -0.76890725),
    vec2(-0.09418410, -0.92938870), vec2( 0.34495938,  0.29387760),
    vec2(-0.91588581,  0.45771432), vec2(-0.81544232, -0.87912464),
    vec2(-0.38277543,  0.27676845), vec2( 0.97484398,  0.75648379),
    vec2( 0.44323325, -0.97511554), vec2( 0.53742981, -0.47373420),
    vec2(-0.26496911, -0.41893023), vec2( 0.79197514,  0.19090188),
    vec2(-0.24188840,  0.99706507), vec2(-0.81409955,  0.91437590),
    vec2( 0.19984126,  0.78641367), vec2( 0.14383161, -0.14100790)
);

float PCF(sampler2DArrayShadow shadowMap, vec4 shadowCoord, uint cascadeIndex, float bias, vec2 texelSize) {
    float shadow = 0.0;
    float compareDepth = shadowCoord.z - bias;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 offset = vec2(x, y) * texelSize;
            shadow += texture(shadowMap, vec4(shadowCoord.xy + offset, cascadeIndex, compareDepth));
        }
    }
    return shadow / 9.0;
}

float PCSS(sampler2DArray depthMap, sampler2DArrayShadow shadowMap, vec4 shadowCoord, uint cascadeIndex, float bias, vec2 texelSize) {
    const float cascadeScale[3] = float[](1.0, 0.25, 0.05);
    float scale = cascadeIndex < 3 ? cascadeScale[cascadeIndex] : 0.05;

    float searchRadius = 12.0 * scale; 
    float avgBlockerDepth = 0.0;
    int numBlockers = 0;

    for (int i = 0; i < 16; i++) {
        vec2 offset = poissonDisk[i] * texelSize * searchRadius;
        float depth = texture(depthMap, vec3(shadowCoord.xy + offset, float(cascadeIndex))).r;
        if (depth < shadowCoord.z - bias) {
            avgBlockerDepth += depth;
            numBlockers++;
        }
    }

    if (numBlockers == 0) return 1.0;

    avgBlockerDepth /= float(numBlockers);
    float depthDiff = max(shadowCoord.z - avgBlockerDepth, 0.0);

    float pcfRadius = clamp(depthDiff * 2500.0 * scale, 0.001, 16.0 * scale); 

    float illuminated = 0.0;
    float compareDepth = shadowCoord.z - bias;
    for (int i = 0; i < 16; i++) {
        vec2 offset = poissonDisk[i] * texelSize * pcfRadius;
        illuminated += texture(shadowMap, vec4(shadowCoord.xy + offset, cascadeIndex, compareDepth));
    }
    return illuminated / 16.0;
}

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = textureSize(visBufferTexture, 0);

    if (pixel.x >= texSize.x || pixel.y >= texSize.y) return;

    uint pixelIdx = pixel.y * texSize.x + pixel.x;

    uvec4 visPacked = texelFetch(visBufferTexture, pixel, 0);

    uint instanceID = visPacked.x;
    uint primitiveID = visPacked.y;

    if (instanceID == 0u) {
        normalOut.packedNormals[pixelIdx] = 0u;
        radianceOut.packedRadiances[pixelIdx] = 0u;
        worldOut.worldPositions[pixelIdx] = vec4(0.0, 0.0, 0.0, 0.0);
        imageStore(finalRenderOut, pixel, vec4(0.1, 0.1, 0.12, 1.0));
        return;
    }

    instanceID -= 1u;

    uvec2 primKey = uvec2(instanceID, primitiveID);
    bool isUniformPrimitive = subgroupAllEqual(primKey);

    Mesh mesh = meshBuffer.meshes[instanceID];
    mat4 modelMatrix = objectBuffer.objects[instanceID].modelMatrix;
    mat4 MVP = pc.viewProj * modelMatrix;
    mat3 normalMatrix = mat3(objectBuffer.objects[instanceID].normalMatrix);

    uint globalIndexOffset = mesh.firstIndex + primitiveID * 3u;
    uint idx0 = indexBuffer.indices[globalIndexOffset];
    uint idx1 = indexBuffer.indices[globalIndexOffset + 1u];
    uint idx2 = indexBuffer.indices[globalIndexOffset + 2u];

    uint vOffset = uint(mesh.vertexOffset);
    PositionData pd0 = vertexBuffer.positions[vOffset + idx0];
    PositionData pd1 = vertexBuffer.positions[vOffset + idx1];
    PositionData pd2 = vertexBuffer.positions[vOffset + idx2];

    vec3 p0 = (modelMatrix * vec4(pd0.x, pd0.y, pd0.z, 1.0)).xyz;
    vec3 p1 = (modelMatrix * vec4(pd1.x, pd1.y, pd1.z, 1.0)).xyz;
    vec3 p2 = (modelMatrix * vec4(pd2.x, pd2.y, pd2.z, 1.0)).xyz;

    vec4 clip0 = MVP * vec4(pd0.x, pd0.y, pd0.z, 1.0);
    vec4 clip1 = MVP * vec4(pd1.x, pd1.y, pd1.z, 1.0);
    vec4 clip2 = MVP * vec4(pd2.x, pd2.y, pd2.z, 1.0);

    vec2 pixelNDC = (vec2(pixel) + 0.5) / vec2(texSize) * 2.0 - 1.0;

    vec4 d0 = clip0 - clip2;
    vec4 d1 = clip1 - clip2;

    float Ax = pixelNDC.x * d0.w - d0.x;
    float Bx = pixelNDC.x * d1.w - d1.x;
    float Rx = clip2.x - pixelNDC.x * clip2.w;

    float Ay = pixelNDC.y * d0.w - d0.y;
    float By = pixelNDC.y * d1.w - d1.y;
    float Ry = clip2.y - pixelNDC.y * clip2.w;

    float M = Ax * By - Ay * Bx;
    M = abs(M) < 1e-7 ? (M >= 0.0 ? 1e-7 : -1e-7) : M;

    float u = (Rx * By - Ry * Bx) / M;
    float v = (Ax * Ry - Ay * Rx) / M;
    vec3 bary = vec3(u, v, 1.0 - u - v);

    vec2 invRes = 2.0 / vec2(texSize);

    vec2 ndc_dx = pixelNDC + vec2(invRes.x, 0.0);
    float Ax_dx = ndc_dx.x * d0.w - d0.x;
    float Bx_dx = ndc_dx.x * d1.w - d1.x;
    float Rx_dx = clip2.x - ndc_dx.x * clip2.w;

    float M_dx = Ax_dx * By - Ay * Bx_dx;
    M_dx = abs(M_dx) < 1e-7 ? (M_dx >= 0.0 ? 1e-7 : -1e-7) : M_dx;

    float u_dx = (Rx_dx * By - Ry * Bx_dx) / M_dx;
    float v_dx = (Ax_dx * Ry - Ay * Rx_dx) / M_dx;
    vec3 bary_dx = vec3(u_dx, v_dx, 1.0 - u_dx - v_dx);

    vec2 ndc_dy = pixelNDC + vec2(0.0, invRes.y);
    float Ay_dy = ndc_dy.y * d0.w - d0.y;
    float By_dy = ndc_dy.y * d1.w - d1.y;
    float Ry_dy = clip2.y - ndc_dy.y * clip2.w;

    float M_dy = Ax * By_dy - Ay_dy * Bx;
    M_dy = abs(M_dy) < 1e-7 ? (M_dy >= 0.0 ? 1e-7 : -1e-7) : M_dy;

    float u_dy = (Rx * By_dy - Ry_dy * Bx) / M_dy;
    float v_dy = (Ax * Ry_dy - Ay_dy * Rx) / M_dy;
    vec3 bary_dy = vec3(u_dy, v_dy, 1.0 - u_dy - v_dy);

    vec3 worldPos = bary.x * p0 + bary.y * p1 + bary.z * p2;

    VertexAttribute a0 = attributeBuffer.attributes[vOffset + idx0];
    VertexAttribute a1 = attributeBuffer.attributes[vOffset + idx1];
    VertexAttribute a2 = attributeBuffer.attributes[vOffset + idx2];

    vec3 n0 = normalMatrix * vec3(a0.normalX, a0.normalY, a0.normalZ);
    vec4 t0 = vec4(normalMatrix * vec3(a0.tangentX, a0.tangentY, a0.tangentZ), a0.tangentW);
    vec2 uv0 = vec2(a0.uvX, a0.uvY);

    vec3 n1 = normalMatrix * vec3(a1.normalX, a1.normalY, a1.normalZ);
    vec4 t1 = vec4(normalMatrix * vec3(a1.tangentX, a1.tangentY, a1.tangentZ), a1.tangentW);
    vec2 uv1 = vec2(a1.uvX, a1.uvY);

    vec3 n2 = normalMatrix * vec3(a2.normalX, a2.normalY, a2.normalZ);
    vec4 t2 = vec4(normalMatrix * vec3(a2.tangentX, a2.tangentY, a2.tangentZ), a2.tangentW);
    vec2 uv2 = vec2(a2.uvX, a2.uvY);

    vec3 normal = normalize(bary.x * n0 + bary.y * n1 + bary.z * n2);
    vec4 tangent = bary.x * t0 + bary.y * t1 + bary.z * t2;
    vec2 texCoord = bary.x * uv0 + bary.y * uv1 + bary.z * uv2;

    vec2 texCoord_dx = bary_dx.x * uv0 + bary_dx.y * uv1 + bary_dx.z * uv2;
    vec2 texCoord_dy = bary_dy.x * uv0 + bary_dy.y * uv1 + bary_dy.z * uv2;
    vec2 ddx_uv = texCoord_dx - texCoord;
    vec2 ddy_uv = texCoord_dy - texCoord;

    uint materialId = a0.texId;
    MaterialData mat;

    vec3 albedo;
    vec3 normalMapSample;
    vec4 mrSample;
    float materialAO;

    if (subgroupAllEqual(materialId)) {
        mat = materialHeap.materials[materialId];
        albedo = textureGrad(bindlessTextures[mat.albedoIndex], texCoord, ddx_uv, ddy_uv).rgb * mat.albedoFactor.rgb;
        normalMapSample = textureGrad(bindlessTextures[mat.normalIndex], texCoord, ddx_uv, ddy_uv).rgb;
        mrSample = textureGrad(bindlessTextures[mat.roughnessMetallicIndex], texCoord, ddx_uv, ddy_uv);
        materialAO = textureGrad(bindlessTextures[mat.occlusionIndex], texCoord, ddx_uv, ddy_uv).r;
    } else {
        uvec4 activeLanes = subgroupBallot(true);
        for (int iter = 0; iter < 32; ++iter) {
            if (activeLanes == uvec4(0)) break;

            uint firstActiveLane = subgroupBallotFindLSB(activeLanes);
            uint currentMatId = subgroupBroadcast(materialId, firstActiveLane);

            if (materialId == currentMatId) {
                mat = materialHeap.materials[currentMatId];
                albedo = textureGrad(bindlessTextures[mat.albedoIndex], texCoord, ddx_uv, ddy_uv).rgb * mat.albedoFactor.rgb;
                normalMapSample = textureGrad(bindlessTextures[mat.normalIndex], texCoord, ddx_uv, ddy_uv).rgb;
                mrSample = textureGrad(bindlessTextures[mat.roughnessMetallicIndex], texCoord, ddx_uv, ddy_uv);
                materialAO = textureGrad(bindlessTextures[mat.occlusionIndex], texCoord, ddx_uv, ddy_uv).r;
            }

            uvec4 matchMask = subgroupBallot(materialId == currentMatId);
            activeLanes.x &= ~matchMask.x;
            activeLanes.y &= ~matchMask.y;
            activeLanes.z &= ~matchMask.z;
            activeLanes.w &= ~matchMask.w;
        }
    }

    float roughness = mrSample.g * mat.roughnessFactor;
    float metalness = mrSample.b * mat.metallicFactor;

    vec3 worldNormal = normal;
    if (length(tangent.xyz) > 0.001) {
        vec3 mappedNormal = normalize(vec3((normalMapSample.xy * 2.0 - 1.0) * mat.normalScale, normalMapSample.z * 2.0 - 1.0));
        vec3 bitangent = cross(normal, tangent.xyz) * tangent.w;
        mat3 tbn = mat3(normalize(tangent.xyz), normalize(bitangent), normal);
        worldNormal = normalize(tbn * mappedNormal);
    }

    vec3 lightDir = normalize(sceneUbo.directionalLight.xyz);
    vec3 viewDir  = normalize(pc.cameraPos - worldPos);
    vec3 H        = normalize(viewDir + lightDir);

    float rawNdotL = dot(worldNormal, lightDir);
    float NdotL    = max(rawNdotL, 0.0);
    float NdotV    = max(dot(worldNormal, viewDir), Epsilon);

    vec3 F0 = mix(Fdielectric, albedo, metalness);

    float NdotL_diffuse = NdotL;
    float lightRoughness = max(roughness, 0.05);

    float NDF = ndfGGX(max(dot(worldNormal, H), 0.0), lightRoughness);
    float G   = gaSchlickGGX(NdotL, NdotV, lightRoughness);
    vec3  F   = fresnelSchlick(F0, max(dot(H, viewDir), 0.0));

    vec3 specular = (NDF * G * F) / (4.0 * NdotV + Epsilon);
    vec3 kD       = (vec3(1.0) - F) * (1.0 - metalness);

    vec4 viewPos = pc.view * vec4(worldPos, 1.0);
    float depth = viewPos.z;
    
    uint cascadeIndex = 0;
    for(uint i = 0; i < 2; ++i) {
        if(depth > sceneUbo.cascadesSplits[i]) {
            cascadeIndex = i + 1;
        }
    }

    const float cascadeScale[3] = float[](1.0, 0.35, 0.1);
    float scale = cascadeIndex < 3 ? cascadeScale[cascadeIndex] : 0.1;

    float slopeScale = 1.0 - max(rawNdotL, 0.0);
    float normalBiasAmt = 0.005 + 0.01 * slopeScale;
    vec3 shadowWorldPos = worldPos + worldNormal * normalBiasAmt;

    vec4 shadowCoord = sceneUbo.lightViewProj[cascadeIndex] * vec4(shadowWorldPos, 1.0);
    shadowCoord /= shadowCoord.w;
    shadowCoord.xy = shadowCoord.xy * 0.5 + 0.5;

    float shadowFactor = 1.0;
    if (shadowCoord.x > 0.0 && shadowCoord.x < 1.0 &&
        shadowCoord.y > 0.0 && shadowCoord.y < 1.0 &&
        shadowCoord.z > 0.0 && shadowCoord.z < 1.0) {

        vec2 texelSize = 1.0 / vec2(textureSize(csmShadowMap, 0).xy);
        float bias = 0.0002;

        if (ENABLE_PCSS == 1) {
            shadowFactor = PCSS(csmDepthMap, csmShadowMap, shadowCoord, cascadeIndex, bias, texelSize);
        } else {
            shadowFactor = PCF(csmShadowMap, shadowCoord, cascadeIndex, bias, texelSize);
        }
    }

    if (cascadeIndex < 2) {
        float splitDist = sceneUbo.cascadesSplits[cascadeIndex];
        float blendBand = 0.2; // Blend over 0.2 meters
        if (depth > splitDist - blendBand && depth < splitDist) {
            float blendFactor = (depth - (splitDist - blendBand)) / blendBand;
            
            uint nextCascade = cascadeIndex + 1;
            float nextNormalBiasAmt = 0.005 + 0.01 * slopeScale;
            vec3 nextShadowWorldPos = worldPos + worldNormal * nextNormalBiasAmt;
            
            vec4 nextCoord = sceneUbo.lightViewProj[nextCascade] * vec4(nextShadowWorldPos, 1.0);
            nextCoord /= nextCoord.w;
            nextCoord.xy = nextCoord.xy * 0.5 + 0.5;
            
            float nextShadowFactor = 1.0;
            if (nextCoord.x > 0.0 && nextCoord.x < 1.0 &&
                nextCoord.y > 0.0 && nextCoord.y < 1.0 &&
                nextCoord.z > 0.0 && nextCoord.z < 1.0) {
                
                vec2 texelSize = 1.0 / vec2(textureSize(csmShadowMap, 0).xy);
                float bias = 0.0002;

                if (ENABLE_PCSS == 1) {
                    nextShadowFactor = PCSS(csmDepthMap, csmShadowMap, nextCoord, nextCascade, bias, texelSize);
                } else {
                    nextShadowFactor = PCF(csmShadowMap, nextCoord, nextCascade, bias, texelSize);
                }
            }
            shadowFactor = mix(shadowFactor, nextShadowFactor, blendFactor);
        }
    }

    float lightIntensity = sceneUbo.directionalLight.w;
    vec3 directLight = (kD * albedo / PI * NdotL_diffuse + specular) * vec3(lightIntensity) * shadowFactor;

    vec3 F_ambient  = fresnelSchlickRoughness(NdotV, F0, roughness);
    vec3 kD_ambient = (vec3(1.0) - F_ambient) * (1.0 - metalness);

    vec3 irradiance = texture(irradianceMap, worldNormal).rgb;
    vec3 diffuse_ambient = irradiance * albedo;

    const float MAX_REFLECTION_LOD = 4.0;
    vec3 R = reflect(-viewDir, worldNormal);

    vec3 prefilteredColor = textureLod(prefilterMap, R, roughness * MAX_REFLECTION_LOD).rgb;
    vec2 envBRDF = texture(brdfLUT, vec2(NdotV, roughness)).rg;
    vec3 specular_ambient = prefilteredColor * (F_ambient * envBRDF.x + envBRDF.y);

    vec2 uv = (vec2(pixel) + 0.5) / vec2(texSize);
    float ssao = 1.0;
    if (pc.enableSSAO == 1u) {
        ssao = texture(ssaoBlurTex, uv).r;
    }

    float combinedAO = ssao * materialAO;

    vec3 ambientLight = (kD_ambient * diffuse_ambient + specular_ambient) * combinedAO;

    vec3 finalRadiance = directLight + ambientLight;

    uint packedNormal = encodeOctNormal(worldNormal);
    uint packedRadiance = encodeRadiance(finalRadiance);

    normalOut.packedNormals[pixelIdx] = packedNormal;
    radianceOut.packedRadiances[pixelIdx] = packedRadiance;
    worldOut.worldPositions[pixelIdx] = vec4(worldPos, 1.0);

    imageStore(finalRenderOut, pixel, vec4(finalRadiance, 1.0));
}