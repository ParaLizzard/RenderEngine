#version 460

#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x_id = 0, local_size_x = 256) in;

struct Meshlet {
    float center_x;
    float center_y;
    float center_z;
    float radius;
    uint cone_axis_cutoff; // packed 4x8 signed chars
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint triangleCount;
};

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
    uint baseMeshlet;
    uint meshletCount;
    uint alphaMode;
    uint padding1;
};

layout(std430, set = 0, binding = 5) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 0, binding = 8) readonly buffer MeshletBuffer {
    Meshlet meshlets[];
};

layout(std430, set = 1, binding = 1) readonly buffer VisibleObjectBuffer {
    uint visibleObjects[];
};

layout(std430, set = 1, binding = 2) buffer SingleIndirectCommandBuffer {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout(std430, set = 1, binding = 3) buffer CompactedIndexBuffer {
    uint syntheticIndices[];
};

layout(std430, set = 1, binding = 4) writeonly buffer VisibleMeshletBuffer {
    uvec2 visibleMeshlets[];
};

layout(std430, set = 1, binding = 5) buffer TriangleDispatchCommandBuffer {
    uint dispatchX;
    uint dispatchY;
    uint dispatchZ;
};

layout(push_constant) uniform PushConsts {
    mat4 viewProj;
    vec4 frustumPlanes[6];
    vec3 cameraPos;
    uint cullFlags;
    uint objectCount;
    uint actualObjectCount;
    float projM11;
    uint objectCapacity;
    uint clipPlaneCount;
    uint targetAlphaMode;
} push;

const float SUBPIXEL_THRESHOLD = 0.0005;

void main() {
    uint visibleObjectIndex = gl_WorkGroupID.x;
    if (visibleObjectIndex >= push.actualObjectCount) return;

    uint objectID = visibleObjects[visibleObjectIndex];
    ObjectData obj = objects[objectID];

    float sqX = dot(obj.modelMatrix[0].xyz, obj.modelMatrix[0].xyz);
    float sqY = dot(obj.modelMatrix[1].xyz, obj.modelMatrix[1].xyz);
    float sqZ = dot(obj.modelMatrix[2].xyz, obj.modelMatrix[2].xyz);
    float maxScale = sqrt(max(max(sqX, sqY), sqZ));

    // --- Debug Flags ---
    bool enableFrustumCull = true;
    bool enableContributionCull = true;
    bool enableConeCull = true;
    // -------------------

    for (uint i = gl_LocalInvocationID.x; i < obj.meshletCount; i += gl_WorkGroupSize.x) {
        bool isValid = true;
        
        bool visible = false;
        Meshlet m;
        
        if (isValid) {
            uint meshletID = obj.baseMeshlet + i;
            m = meshlets[meshletID];

            vec3 localCenter = vec3(m.center_x, m.center_y, m.center_z);
            vec3 worldCenter = (obj.modelMatrix * vec4(localCenter, 1.0)).xyz;
            float worldRadius = m.radius * maxScale;

            visible = true;
            if (enableFrustumCull) {
                for (uint p = 0u; p < push.clipPlaneCount; p++) {
                    if (dot(push.frustumPlanes[p].xyz, worldCenter) + push.frustumPlanes[p].w < -worldRadius) {
                        visible = false;
                        break;
                    }
                }
            }

            if (visible && enableContributionCull) {
                vec3 camToCenter = worldCenter - push.cameraPos;
                float dist = length(camToCenter);
                if (dist > worldRadius) {
                    float projRadius = (worldRadius / dist) * abs(push.projM11);
                    if (projRadius < SUBPIXEL_THRESHOLD) {
                        visible = false;
                    }
                }
            }
                
            if (push.cullFlags == 0) {
                visible = true;
            }

            if (visible && enableConeCull) {
                vec4 cone = unpackSnorm4x8(m.cone_axis_cutoff);
                vec3 cone_axis_local = cone.xyz;
                float cone_cutoff = cone.w;
                
                bool doubleSided = (obj.alphaMode & 4u) != 0u;

                if (!doubleSided && cone_cutoff < 0.99) {
                    vec3 cone_axis_world = normalize(mat3(obj.normalMatrix) * cone_axis_local);

                    vec3 camera_to_center = worldCenter - push.cameraPos;
                    float distSq = dot(camera_to_center, camera_to_center);

                    if (distSq > worldRadius * worldRadius) {
                        float dist = sqrt(distSq);
                        vec3 dir_to_center = camera_to_center / dist;

                        float sin_subtended = clamp(worldRadius / dist, 0.0, 1.0);
                        float cos_subtended = sqrt(1.0 - sin_subtended * sin_subtended);
                        float cone_sin = sqrt(max(0.0, 1.0 - cone_cutoff * cone_cutoff));
                        float max_dot = cone_cutoff * cos_subtended + cone_sin * sin_subtended;

                        if (dot(cone_axis_world, dir_to_center) >= max_dot) {
                            visible = false;
                        }
                    }
                }
            }
        }

        #ifdef GL_KHR_shader_subgroup_arithmetic
        uint visibleFlag = visible ? 1u : 0u;
        uint waveVisibleCount = subgroupAdd(visibleFlag);
        uint waveVisibleOffset = subgroupExclusiveAdd(visibleFlag);
        
        uint waveVisibleBase = 0u;
        if (subgroupElect()) {
            if (waveVisibleCount > 0u) {
                waveVisibleBase = atomicAdd(dispatchX, waveVisibleCount);
            }
        }
        waveVisibleBase = subgroupBroadcast(waveVisibleBase, subgroupBallotFindLSB(subgroupBallot(true)));
        
        if (visible) {
            uint localIdx = waveVisibleBase + waveVisibleOffset;
            visibleMeshlets[localIdx] = uvec2(objectID, i);
        }
        #else
        if (visible) {
            uint localIdx = atomicAdd(dispatchX, 1u);
            visibleMeshlets[localIdx] = uvec2(objectID, i);
        }
        #endif
    }
}