#version 460
#extension GL_GOOGLE_include_directive : enable
#include "hiz_cull.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
    uint baseMeshlet;
    uint meshletCount;
    uint alphaMode;
    uint materialId;
};

layout(set = 0, binding = 1) uniform SceneUbo {
    mat4 viewProj;
    mat4 prevViewProj;
    vec4 frustumPlanes[6];
    vec4 cameraPos;
    vec4 directionalLight;
    mat4 lightViewProj[3];
    vec4 cascadesSplits;
    float maxReflectionLod;
    uint blueNoiseTexIndex;
    vec2 _pad;
} sceneUbo;

layout(std430, set = 0, binding = 5) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

layout(std430, set = 1, binding = 0) buffer DispatchCommandBuffer {
    uint dispatchX;
    uint dispatchY;
    uint dispatchZ;
};

layout(std430, set = 1, binding = 1) buffer VisibleObjectBuffer {
    uint visibleObjects[];
};

layout(set = 1, binding = 8) uniform sampler2D hizPyramid;

layout(std430, set = 1, binding = 9) buffer CandidateDispatchCommandBuffer {
    uint candidateDispatchX;
    uint candidateDispatchY;
    uint candidateDispatchZ;
};

layout(std430, set = 1, binding = 10) buffer CandidateObjectBuffer {
    uint candidateObjects[];
};

layout(push_constant) uniform PushConsts {
    mat4 view;
    vec4 projParams;
    vec4 hizParams;
    vec2 screenParams;
    uint cullFlags;
    uint objectCount;
    uint actualObjectCount;
    uint objectCapacity;
    uint clipPlaneCount;
    uint targetAlphaMode;
    uint phase;
    uint pad;
} push;

const float SUBPIXEL_THRESHOLD = 0.0005;

void main() {
    uint invocationID = gl_GlobalInvocationID.x;

    if (push.phase == 0u) {
        if (invocationID >= push.actualObjectCount) return;
        uint objectID = invocationID;
        ObjectData obj = objects[objectID];

        if (obj.meshletCount == 0 || (obj.alphaMode & 3u) != push.targetAlphaMode) {
            return;
        }

        vec4 sphere = obj.boundingSphere;
        vec3 localCenter = sphere.xyz;
        vec3 worldCenter = (obj.modelMatrix * vec4(localCenter, 1.0)).xyz;
        
        float sqX = dot(obj.modelMatrix[0].xyz, obj.modelMatrix[0].xyz);
        float sqY = dot(obj.modelMatrix[1].xyz, obj.modelMatrix[1].xyz);
        float sqZ = dot(obj.modelMatrix[2].xyz, obj.modelMatrix[2].xyz);
        float maxScale = sqrt(max(max(sqX, sqY), sqZ));
        float worldRadius = sphere.w * maxScale;

        bool inFrustum = true;
        if ((push.cullFlags & 1u) != 0u) {
            for (uint i = 0u; i < push.clipPlaneCount; i++) {
                if (dot(sceneUbo.frustumPlanes[i].xyz, worldCenter) + sceneUbo.frustumPlanes[i].w < -worldRadius) {
                    inFrustum = false;
                    break;
                }
            }
        }

        if (!inFrustum) return;

        if ((push.cullFlags & 2u) != 0u) {
            vec3 camToCenter = worldCenter - sceneUbo.cameraPos.xyz;
            float dist = length(camToCenter);
            if (dist > worldRadius) {
                float projRadius = (worldRadius / dist) * abs(sceneUbo.cameraPos.w);
                if (projRadius < SUBPIXEL_THRESHOLD) {
                    return;
                }
            }
        }

        bool occluded = false;
        if ((push.cullFlags & 4u) != 0u) {
            vec3 centerView = (push.view * vec4(worldCenter, 1.0)).xyz;
            occluded = isSphereOccludedHiZ(hizPyramid, centerView, worldRadius, push.projParams, push.hizParams, push.screenParams);
        }

        if (!occluded || push.cullFlags == 0u) {
            uint slot = atomicAdd(dispatchX, 1);
            visibleObjects[slot] = objectID;
        } else {
            uint candSlot = atomicAdd(candidateDispatchX, 1);
            candidateObjects[candSlot] = objectID;
        }
    } else {
        if (invocationID >= candidateDispatchX) return;
        uint objectID = candidateObjects[invocationID];
        ObjectData obj = objects[objectID];

        vec4 sphere = obj.boundingSphere;
        vec3 localCenter = sphere.xyz;
        vec3 worldCenter = (obj.modelMatrix * vec4(localCenter, 1.0)).xyz;

        float sqX = dot(obj.modelMatrix[0].xyz, obj.modelMatrix[0].xyz);
        float sqY = dot(obj.modelMatrix[1].xyz, obj.modelMatrix[1].xyz);
        float sqZ = dot(obj.modelMatrix[2].xyz, obj.modelMatrix[2].xyz);
        float maxScale = sqrt(max(max(sqX, sqY), sqZ));
        float worldRadius = sphere.w * maxScale;

        vec3 centerView = (push.view * vec4(worldCenter, 1.0)).xyz;
        bool occluded = isSphereOccludedHiZ(hizPyramid, centerView, worldRadius, push.projParams, push.hizParams, push.screenParams);

        if (!occluded) {
            uint slot = atomicAdd(dispatchX, 1);
            visibleObjects[slot] = objectID;
        }
    }

    if (gl_GlobalInvocationID.x == 0) {
        dispatchY = 1;
        dispatchZ = 1;
        candidateDispatchY = 1;
        candidateDispatchZ = 1;
    }
}
