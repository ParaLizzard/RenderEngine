#version 460

layout(local_size_x_id = 0, local_size_x = 256) in;

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
    uint baseMeshlet;
    uint meshletCount;
    uint alphaMode;
    uint padding1;
};

layout(set = 0, binding = 1) uniform SceneUbo {
    mat4 viewProj;
    mat4 prevViewProj;
    vec4 frustumPlanes[6];
    vec4 cameraPos;
    vec4 directionalLight;
    mat4 lightViewProj[3];
    vec4 cascadesSplits;
    float maxReflectionLod;
    uint blueNoiseTexIndex;
    vec2 _pad;
} sceneUbo;

layout(std430, set = 0, binding = 5) readonly buffer ObjectBuffer {
    ObjectData objects[];
};

// --- CullPass Local Buffers (set = 1) ---

layout(std430, set = 1, binding = 0) buffer DispatchCommandBuffer {
    uint dispatchX;
    uint dispatchY;
    uint dispatchZ;
};

layout(std430, set = 1, binding = 1) buffer VisibleObjectBuffer {
    uint visibleObjects[];
};

layout(push_constant) uniform PushConsts {
    uint cullFlags;
    uint objectCount; // total Meshlets
    uint actualObjectCount; // real objects
    uint objectCapacity;
    uint clipPlaneCount;
    uint targetAlphaMode;
} push;

const float SUBPIXEL_THRESHOLD = 0.0005;

void main() {
    uint objectID = gl_GlobalInvocationID.x;
    if (objectID >= push.actualObjectCount) return;

    ObjectData obj = objects[objectID];

    if (obj.meshletCount == 0 || (obj.alphaMode & 3u) == 2) {
        return;
    }

    // 1. Calculate World Space Sphere
    vec4 sphere = obj.boundingSphere;
    vec3 localCenter = sphere.xyz;
    vec3 worldCenter = (obj.modelMatrix * vec4(localCenter, 1.0)).xyz;
    
    // Scale radius by object transform
    float sqX = dot(obj.modelMatrix[0].xyz, obj.modelMatrix[0].xyz);
    float sqY = dot(obj.modelMatrix[1].xyz, obj.modelMatrix[1].xyz);
    float sqZ = dot(obj.modelMatrix[2].xyz, obj.modelMatrix[2].xyz);
    float maxScale = sqrt(max(max(sqX, sqY), sqZ));
    float worldRadius = sphere.w * maxScale;

    // --- Debug Flags ---
    bool enableFrustumCull = true;
    bool enableContributionCull = true;
    // -------------------

    // 2. Frustum Culling
    bool visible = true;
    if (enableFrustumCull) {
        for (uint i = 0u; i < push.clipPlaneCount; i++) {
            if (dot(sceneUbo.frustumPlanes[i].xyz, worldCenter) + sceneUbo.frustumPlanes[i].w < -worldRadius) {
                visible = false;
                break;
            }
        }
    }

    // 3. Contribution Culling
    if (visible && enableContributionCull) {
        vec3 camToCenter = worldCenter - sceneUbo.cameraPos.xyz;
        float dist = length(camToCenter);
        if (dist > worldRadius) {
            float projRadius = (worldRadius / dist) * abs(sceneUbo.cameraPos.w);
            if (projRadius < SUBPIXEL_THRESHOLD) {
                visible = false;
            }
        }
    }
    
    if (push.cullFlags == 0) {
        visible = true;
    }

    if (visible) {
        uint slot = atomicAdd(dispatchX, 1);
        visibleObjects[slot] = objectID;
    }

    if (gl_GlobalInvocationID.x == 0) {
        dispatchY = 1;
        dispatchZ = 1;
    }
}
