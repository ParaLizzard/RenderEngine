#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

layout(push_constant) uniform PushConsts {
    uint cascadeIndex;
    uint maxTaskWgsPerCascade;
} push;

struct PositionData {
    float x, y, z;
};

struct ObjectData {
    mat4 modelMatrix;
    mat4 normalMatrix;
    vec4 boundingSphere;
    uint baseMeshlet;
    uint meshletCount;
    uint alphaMode;
    uint materialId;
};

struct Meshlet {
    float center_x;
    float center_y;
    float center_z;
    float radius;
    uint cone_axis_cutoff;
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint triangleCount;
};

layout(set = 0, binding = 1) uniform SceneUbo {
    mat4 viewProj;
    mat4 prevViewProj;
    vec4 frustumPlanes[6];
    vec4 cameraPosition;
    vec4 directionalLight;
    mat4 lightViewProj[3];
    vec4 cascadesSplits;
    float maxReflectionLod;
    uint blueNoiseTexIndex;
    vec2 padding;
} sceneUbo;

layout(std430, set = 0, binding = 5) readonly buffer ObjectBuffer { ObjectData objects[]; };
layout(std430, set = 0, binding = 6) readonly buffer VertexBuffer { PositionData positions[]; };
layout(std430, set = 0, binding = 8) readonly buffer MeshletBuffer { Meshlet meshlets[]; };
layout(std430, set = 0, binding = 9) readonly buffer MeshletVertexMap { uint meshletVertices[]; };
layout(std430, set = 0, binding = 10) readonly buffer MeshletTriangleMap { uint8_t meshletTriangles[]; };

struct Payload {
    uint objectID;
    uint meshletIndices[32];
};

taskPayloadSharedEXT Payload payload;

void main() {
    uint objectID = payload.objectID;
    uint localMeshletIdx = payload.meshletIndices[gl_WorkGroupID.x];
    uint cascadeIndex = push.cascadeIndex;
    uint ti = gl_LocalInvocationID.x;

    ObjectData obj = objects[objectID];
    uint globalMeshletID = obj.baseMeshlet + localMeshletIdx;
    Meshlet m = meshlets[globalMeshletID];

    uint vertexCount = m.vertexCount;
    uint triangleCount = m.triangleCount;

    SetMeshOutputsEXT(vertexCount, triangleCount);

    mat4 lightModelViewProj = sceneUbo.lightViewProj[cascadeIndex] * obj.modelMatrix;

    if (ti < vertexCount) {
        uint globalVertexID = meshletVertices[m.vertexOffset + ti];
        PositionData pd = positions[globalVertexID];
        gl_MeshVerticesEXT[ti].gl_Position = lightModelViewProj * vec4(pd.x, pd.y, pd.z, 1.0);
    }

    for (uint triIdx = ti; triIdx < triangleCount; triIdx += 64u) {
        uint triOffset = m.indexOffset + triIdx * 3u;
        uint v0 = uint(meshletTriangles[triOffset + 0u]);
        uint v1 = uint(meshletTriangles[triOffset + 1u]);
        uint v2 = uint(meshletTriangles[triOffset + 2u]);
        gl_PrimitiveTriangleIndicesEXT[triIdx] = uvec3(v0, v1, v2);
    }
}
