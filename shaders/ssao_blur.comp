#version 460

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0) uniform sampler2D samplerSSAO;
layout (binding = 1) uniform sampler2D samplerDepth;

layout (binding = 2) uniform UBO
{
    mat4 projection;
    mat4 invProjection;
    mat4 view;
    vec4 samples[32];
    float nearPlane;
    float farPlane;
} ubo;

layout (binding = 3, r8) uniform writeonly image2D outBlurSsao;

float reconstructViewZ(float depth, vec4 zParams) {
    return (zParams.x * depth + zParams.y) / (zParams.z * depth + zParams.w);
}

void main()
{
    ivec2 blurDim = imageSize(outBlurSsao);
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    
    if (pixelCoords.x >= blurDim.x || pixelCoords.y >= blurDim.y) return;

    vec2 inUV = (vec2(pixelCoords) + 0.5) / vec2(blurDim);

    float centerRawDepth = texture(samplerDepth, inUV).r;
    
    if (centerRawDepth >= 0.99999) {
        imageStore(outBlurSsao, pixelCoords, vec4(1.0));
        return;
    }

    vec4 invZParams = vec4(ubo.invProjection[2][2], ubo.invProjection[3][2], ubo.invProjection[2][3], ubo.invProjection[3][3]);
    float centerDepth = reconstructViewZ(centerRawDepth, invZParams);
    
    vec2 texelSize = 1.0 / vec2(blurDim);
    float result = 0.0;
    float weightSum = 0.0;

    const int blurRange = 1;
    float kernel[3] = float[](0.27901, 0.44198, 0.27901);

    for (int x = -blurRange; x <= blurRange; x++)
    {
        for (int y = -blurRange; y <= blurRange; y++)
        {
            vec2 offset = vec2(float(x), float(y)) * texelSize;
            float sampleRawDepth = texture(samplerDepth, inUV + offset).r;
            float sampleDepth = reconstructViewZ(sampleRawDepth, invZParams);

            float spatialWeight = kernel[x + blurRange] * kernel[y + blurRange];

            float depthDiff = abs(centerDepth - sampleDepth);
            float sigmaDepth = 0.1 + abs(centerDepth) * 0.05;
            float rangeWeight = exp(-(depthDiff * depthDiff) / (2.0 * sigmaDepth * sigmaDepth));

            float weight = spatialWeight * rangeWeight;
            
            result += texture(samplerSSAO, inUV + offset).r * weight;
            weightSum += weight;
        }
    }
    
    float finalColor = weightSum > 0.0001 ? result / weightSum : texture(samplerSSAO, inUV).r;
    imageStore(outBlurSsao, pixelCoords, vec4(finalColor));
}
